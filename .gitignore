# =========================
# C / C++ build artifacts
# =========================

# Object files
*.o
*.obj

# Executables
*.exe
*.out

# Debug symbols
*.pdb

# Other compiler/build files
*.ilk
*.pch
*.d
*.a
*.lib
*.so
*.dll


# =========================
# Build directories
# =========================

build/
Debug/
Release/
x64/
x86/


# =========================
# Visual Studio leftovers
# =========================

.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.user
*.suo


# =========================
# VS Code
# =========================

# Keep project-wide VS Code configuration if we create it.
# Ignore only machine/user-specific files if needed.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.code-workspace


# =========================
# Editor / OS temporary files
# =========================

*~
*.tmp
.DS_Store
Thumbs.db


# =========================
# Advent of Code
# =========================

# Input .txt files are intentionally tracked so they are
# available on both Windows and Linux.